{
    "name": "masilia/ibexa-ai-craft",
    "description": "How Masilia sites are built, for the Ibexa AI OS: pages made of blocks, site structures, and the conventions that go with them",
    "type": "ibexa-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "masilia/ibexa-ai": "^0.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\Bundle\\IbexaAiCraft\\": "src/bundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\IbexaAiCraft\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
