{
    "name": "masilia/ibexa-ai-craft",
    "description": "How Masilia sites are built, for the Ibexa AI OS: pages made of blocks, site structures, and the conventions that go with them",
    "keywords": [
        "ibexa",
        "ibexa-dxp",
        "ibexa-5",
        "symfony-bundle",
        "ai",
        "page-builder",
        "blocks",
        "site-builder"
    ],
    "homepage": "https://github.com/MasiliaLabs/ibexa-ai-craft",
    "license": "MIT",
    "authors": [
        {
            "name": "MasiliaLabs",
            "homepage": "https://github.com/MasiliaLabs"
        }
    ],
    "support": {
        "issues": "https://github.com/MasiliaLabs/ibexa-ai-craft/issues",
        "source": "https://github.com/MasiliaLabs/ibexa-ai-craft",
        "security": "https://github.com/MasiliaLabs/ibexa-ai-craft/security/policy"
    },
    "type": "ibexa-bundle",
    "require": {
        "php": ">=8.3",
        "ibexa/core": "^5.0",
        "masilia/ibexa-ai": "^2.0",
        "masilia/ibexa-blocks": "^0.3 || ^0.4",
        "masilia/ibexa-sites": "^0.1 || ^0.2",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\Bundle\\IbexaAiCraft\\": "src/bundle/",
            "Masilia\\IbexaAiCraft\\": "src/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\IbexaAiCraft\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:masilia/ibexa-ai.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:masilia/ibexa-blocks.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:masilia/ibexa-sites.git"
        }
    ],
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": [
            "@phpunit",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.1.x-dev"
        }
    }
}
